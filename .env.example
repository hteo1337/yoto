# Copy to .env (untracked). Teo supplies account credentials; do not commit them.
# Required for Node self-host (Cloudflare still uses wrangler vars/bindings).
PUBLIC_ORIGIN=https://yoto.example-tailnet.ts.net
YOTO_CLIENT_ID=your-own-yoto-client-id
YOTO_AUTH_SECRET=your-secret-key-here
RESEND_API_KEY=your-resend-api-key-here
# Sidecar only: Teo must provide this before docker compose up.
TS_AUTHKEY=your-tailscale-auth-key-here
TS_HOSTNAME=yoto
